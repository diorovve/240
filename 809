_G.ShivRefreshUI = function()
    for _, e in ipairs(ToggleRegistry) do
        if e.key then
            e.button.Text = e.label .. ": " .. (Config[e.key] and "ON" or "OFF")
            e.button.BackgroundColor3 = Config[e.key] and Color3.fromRGB(40, 70, 50) or Color3.fromRGB(35, 35, 45)
