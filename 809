CreateHeader("Main")
CreateToggle("Auto Kill (Shoot)", "AutoKill", function(state)
    if state and not Running.AutoKill then
        Running.AutoKill = true
        task.spawn(function()
            while Config.AutoKill do
                task.wait(0.05)
                local char = LocalPlayer.Character
                local hrp = char and char:FindFirstChild("HumanoidRootPart")
                if not hrp then continue end
                local nearest, nearestDist, nearestHead = nil, Config.AutoKillRange, nil
                for _, p in ipairs(Players:GetPlayers()) do
                    if p == LocalPlayer then continue end
                    local c = p.Character
                    if not c then continue end
                    local hum = c:FindFirstChildOfClass("Humanoid")
                    if not hum or hum.Health <= 0 then continue end
                    local head = c:FindFirstChild("Head") or c:FindFirstChild("HumanoidRootPart")
                    local tHrp = c:FindFirstChild("HumanoidRootPart")
                    if not head or not tHrp then continue end
                    local d = (tHrp.Position - hrp.Position).Magnitude
                    if d < nearestDist then nearest, nearestDist, nearestHead = p, d, head end
                end
                if nearestHead then
                    Camera.CFrame = CFrame.new(Camera.CFrame.Position, nearestHead.Position)
                    local tool = char:FindFirstChildOfClass("Tool")
                    if tool then pcall(function() tool:Activate() end) end
                    VirtualInputManager:SendMouseButtonEvent(0, 0, 0, true, game, 0)
                    task.wait(0.02)
                    VirtualInputManager:SendMouseButtonEvent(0, 0, 0, false, game, 0)
                    task.wait(0.1)
                end
            end
            Running.AutoKill = false
        end)
    end
end)

