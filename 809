local ToggleRegistry = {}
local function CreateToggle(text, key, callback)
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(1, -4, 0, 30)
    btn.BackgroundColor3 = Color3.fromRGB(35, 35, 45)
    btn.Text = text .. ": OFF"
    btn.TextColor3 = Color3.fromRGB(180, 180, 200)
    btn.Font = Enum.Font.Gotham
    btn.TextSize = 12
    btn.ZIndex = 3
    btn.Parent = Scroll
    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 6)
    corner.Parent = btn
    table.insert(ToggleRegistry, { button = btn, label = text, key = key })
    btn.MouseButton1Click:Connect(function()
        Config[key] = not Config[key]
        btn.Text = text .. ": " .. (Config[key] and "ON" or "OFF")
        btn.BackgroundColor3 = Config[key] and Color3.fromRGB(40, 70, 50) or Color3.fromRGB(35, 35, 45)
        if callback then callback(Config[key]) end
    end)
    return btn
end

local function CreateChoice(text, key, options, onChange)
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(1, -4, 0, 30)
    btn.BackgroundColor3 = Color3.fromRGB(35, 35, 45)
    btn.TextColor3 = Color3.fromRGB(180, 180, 200)
    btn.Font = Enum.Font.Gotham
    btn.TextSize = 12
    btn.ZIndex = 3
    btn.Parent = Scroll
    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 6)
    corner.Parent = btn
    local idx = 1
    for i, o in ipairs(options) do if o.value == Config[key] then idx = i end end
    local function render() btn.Text = text .. ": " .. options[idx].label end
    render()
    btn.MouseButton1Click:Connect(function()
        idx = idx % #options + 1
        Config[key] = options[idx].value
        render()
        if onChange then onChange(Config[key]) end
    end)
    return btn
end

