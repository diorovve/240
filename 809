CreateHeader("Fly")
CreateToggle("Fly (Space/Ctrl)", "Fly", function(state)
    local char = LocalPlayer.Character
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hrp or not hum then return end
    if state then
        local bodyGyro = Instance.new("BodyGyro")
        bodyGyro.Name = "ShivFlyGyro"
        bodyGyro.P = 3e4
        bodyGyro.D = 500
        bodyGyro.MaxTorque = Vector3.new(4e5, 4e5, 4e5)
        bodyGyro.CFrame = hrp.CFrame
        bodyGyro.Parent = hrp
        local bodyVel = Instance.new("BodyVelocity")
        bodyVel.Name = "ShivFlyVel"
        bodyVel.MaxForce = Vector3.new(2e5, 2e5, 2e5)
        bodyVel.Velocity = Vector3.new(0, 0, 0)
        bodyVel.Parent = hrp
        local currentVel = Vector3.new(0, 0, 0)
        local flyConn = RunService.Heartbeat:Connect(function(dt)
            if not Config.Fly or not hrp.Parent or not hum.Parent then
                flyConn:Disconnect()
                if bodyGyro.Parent then bodyGyro:Destroy() end
                if bodyVel.Parent then bodyVel:Destroy() end
                return
            end
            if hum.Health <= 0 then return end
            bodyGyro.CFrame = Camera.CFrame
            local desired = Vector3.new(0, 0, 0)
            if UserInputService:IsKeyDown(Enum.KeyCode.W) then desired = desired + Camera.CFrame.LookVector end
            if UserInputService:IsKeyDown(Enum.KeyCode.S) then desired = desired - Camera.CFrame.LookVector end
            if UserInputService:IsKeyDown(Enum.KeyCode.A) then desired = desired - Camera.CFrame.RightVector end
            if UserInputService:IsKeyDown(Enum.KeyCode.D) then desired = desired + Camera.CFrame.RightVector end
            if UserInputService:IsKeyDown(Enum.KeyCode.Space) then desired = desired + Vector3.new(0, 1, 0) end
            if UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) then desired = desired - Vector3.new(0, 1, 0) end
            if desired.Magnitude > 0 then desired = desired.Unit * Config.FlySpeed end
            currentVel = currentVel:Lerp(desired, Config.FlyAccel)
            bodyVel.Velocity = currentVel
        end)
    else
        for _, v in ipairs(hrp:GetChildren()) do
            if v.Name == "ShivFlyVel" or v.Name == "ShivFlyGyro" then v:Destroy() end
        end
    end
end)

