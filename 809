Players.PlayerRemoving:Connect(function(p)
    for i = #Config.LockedPlayers, 1, -1 do
        if Config.LockedPlayers[i] == p then table.remove(Config.LockedPlayers, i) end
    end
    for i = #Config.ESPTargets, 1, -1 do
        if Config.ESPTargets[i] == p then table.remove(Config.ESPTargets, i) end
