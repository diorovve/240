local function GetAmmo(tool)
    for _, name in ipairs({"Ammo", "CurrentAmmo", "AmmoCount", "Clip", "Bullets", "FireCount"}) do
        local attr = tool:GetAttribute(name)
        if type(attr) == "number" then return attr end
        local child = tool:FindFirstChild(name)
        if child and child:IsA("ValueBase") and type(child.Value) == "number" then
            return child.Value
        end
    end
    return nil
end

-- Мгновенная быстрая перезарядка на каждом кадре
RunService.RenderStepped:Connect(function()
    if not Config.FastReload then return end
    local char = LocalPlayer.Character
    local tool = char and char:FindFirstChildOfClass("Tool")
    if tool then
        local ammo = GetAmmo(tool)
        if ammo ~= nil then
            if ammo <= Config.ReloadThreshold then
                VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.R, false, game)
                VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.R, false, game)
            end
        else
            if not UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton1) then
                VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.R, false, game)
                VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.R, false, game)
            end
        end
    end
end)

