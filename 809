local function RefreshPlayerList()
    local existing = {}
    for _, child in ipairs(PScroll:GetChildren()) do
        if child:IsA("Frame") then existing[child.Name] = child end
    end
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer then
            local key = "P_" .. p.UserId
            local row = existing[key]
            if not row then
                row = Instance.new("Frame")
                row.Name = key
                row.Size = UDim2.new(1, -4, 0, 28)
                row.BackgroundTransparency = 1
                row.Parent = PScroll

                local nameLbl = Instance.new("TextLabel")
                nameLbl.Name = "Name"
                nameLbl.Size = UDim2.new(1, -110, 1, 0)
                nameLbl.Position = UDim2.new(0, 4, 0, 0)
                nameLbl.BackgroundTransparency = 1
                nameLbl.TextXAlignment = Enum.TextXAlignment.Left
                nameLbl.TextColor3 = Color3.fromRGB(200, 200, 220)
                nameLbl.Font = Enum.Font.Gotham
                nameLbl.TextSize = 11
                nameLbl.Parent = row

                local lockBtn = Instance.new("TextButton")
                lockBtn.Name = "LockBtn"
                lockBtn.Size = UDim2.new(0, 48, 1, -4)
                lockBtn.Position = UDim2.new(1, -108, 0, 2)
                lockBtn.Font = Enum.Font.GothamBold
                lockBtn.TextSize = 10
                lockBtn.Parent = row
                local c1 = Instance.new("UICorner"); c1.CornerRadius = UDim.new(0, 4); c1.Parent = lockBtn

                local espBtn = Instance.new("TextButton")
                espBtn.Name = "EspBtn"
                espBtn.Size = UDim2.new(0, 48, 1, -4)
                espBtn.Position = UDim2.new(1, -56, 0, 2)
                espBtn.Font = Enum.Font.GothamBold
                espBtn.TextSize = 10
                espBtn.Parent = row
                local c2 = Instance.new("UICorner"); c2.CornerRadius = UDim.new(0, 4); c2.Parent = espBtn

                lockBtn.MouseButton1Click:Connect(function()
                    ToggleList(Config.LockedPlayers, p)
                    RefreshPlayerList()
                end)
                espBtn.MouseButton1Click:Connect(function()
                    ToggleList(Config.ESPTargets, p)
                    ApplyESPTo(p)
                    RefreshPlayerList()
                end)
            end
            local nameLbl = row:FindFirstChild("Name")
            local lockBtn = row:FindFirstChild("LockBtn")
            local espBtn = row:FindFirstChild("EspBtn")
            local locked = InLockList(p)
            local espOn = InESPList(p)
            nameLbl.Text = p.DisplayName .. " (@" .. p.Name .. ")"
            nameLbl.TextColor3 = locked and Color3.fromRGB(255, 150, 150) or Color3.fromRGB(200, 200, 220)
            lockBtn.Text = locked and "LOCK ✓" or "LOCK"
            lockBtn.BackgroundColor3 = locked and Color3.fromRGB(120, 30, 30) or Color3.fromRGB(45, 45, 55)
            lockBtn.TextColor3 = Color3.fromRGB(240, 220, 220)
            espBtn.Text = espOn and "ESP ✓" or "ESP"
            espBtn.BackgroundColor3 = espOn and Color3.fromRGB(30, 100, 50) or Color3.fromRGB(45, 45, 55)
            espBtn.TextColor3 = Color3.fromRGB(220, 240, 220)
            existing[key] = nil
        end
    end
    for _, row in pairs(existing) do row:Destroy() end
end
