CreateToggle("Fast Reload", "FastReload", function(state)
    if state and not Running.FastReload then
        Running.FastReload = true
        task.spawn(function()
            local lastReloadTime = 0
            while Config.FastReload do
                task.wait(0.05) -- проверяем чаще
                local char = LocalPlayer.Character
                local tool = char and char:FindFirstChildOfClass("Tool")
                if tool then
                    local now = tick()
                    -- 0.1с кулдаун: быстрее не выйдет без лагов
                    if (now - lastReloadTime) < 0.1 then continue end
                    local ammo = GetAmmo(tool)
                    if ammo ~= nil then
                        if ammo <= Config.ReloadThreshold then
                            VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.R, false, game)
                            task.wait(0.01)
                            VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.R, false, game)
                            lastReloadTime = now
                        end
                    else
                        -- если нет аммо, не спамим как бешеные, раз в 0.15с
                        if not Config.LockActive and (now - lastReloadTime) > 0.15 then
                            if not UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton1) then
                                VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.R, false, game)
                                task.wait(0.01)
                                VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.R, false, game)
                                lastReloadTime = now
                            end
                        end
                    end
                end
            end
            Running.FastReload = false
        end)
    end
end)
2. Лок-камера (вместо старого RunService.RenderStepped:Connect(function() ... end) в самом низу):

lua
RunService.RenderStepped:Connect(function()
    if not Config.LockActive then return end
    if #Config.LockedPlayers == 0 then return end
    
    local sum = Vector3.new(0, 0, 0)
    local count = 0
    
    for i = #Config.LockedPlayers, 1, -1 do
        local p = Config.LockedPlayers[i]
        -- если игрок вышел или его персонаж удалён
        if not p or not p.Parent or not p.Character then
            table.remove(Config.LockedPlayers, i)
            continue
        end
        
        local c = p.Character
        local hum = c:FindFirstChildOfClass("Humanoid")
        local head = c:FindFirstChild("Head")
        
        -- Проверка на труп: здоровье > 0 И состояние не Dead
        local isDead = false
        if hum then
            if hum.Health <= 0 then
                isDead = true
            else
                local state = hum:GetState()
                if state == Enum.HumanoidStateType.Dead then
                    isDead = true
                end
            end
        else
            isDead = true -- нет хуманa = точно труп
        end
        
        if not isDead and head then
            sum = sum + head.Position
            count = count + 1
        end
    end
    
    if count > 0 then
        Camera.CFrame = CFrame.new(Camera.CFrame.Position, sum / count)
    end
end)
