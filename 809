    RefreshPlayerList()
end)

-- ============ LOCK INPUT ============
UserInputService.InputBegan:Connect(function(input, gp)
    if gp then return end
    local bind = Config.LockBind
    local matched = (input.KeyCode == bind) or (input.UserInputType == bind)
    if not matched then
        if input.KeyCode == Enum.KeyCode.RightShift then PanicStop() end
        return
    end
    if Config.LockMode == "Press" then
        Config.LockActive = not Config.LockActive
    else
        Config.LockActive = true
    end
end)
UserInputService.InputEnded:Connect(function(input, gp)
    local bind = Config.LockBind
    local matched = (input.KeyCode == bind) or (input.UserInputType == bind)
    if matched and Config.LockMode == "Hold" then
        Config.LockActive = false
    end
end)

-- ============ MULTI LOCK CAMERA ============
RunService.RenderStepped:Connect(function()
    if not Config.LockActive then return end
    if #Config.LockedPlayers == 0 then return end
    local sum = Vector3.new(0, 0, 0)
    local count = 0
    for i = #Config.LockedPlayers, 1, -1 do
        local p = Config.LockedPlayers[i]
        if not p or not p.Parent then
            table.remove(Config.LockedPlayers, i)
            continue
        end
        local c = p.Character
        local hum = c and c:FindFirstChildOfClass("Humanoid")
        local head = c and c:FindFirstChild("Head")
        if hum and hum.Health > 0 and head then
            sum = sum + head.Position
            count = count + 1
        end
    end
    if count > 0 then
        Camera.CFrame = CFrame.new(Camera.CFrame.Position, sum / count)
    end
end)

